DEEPSEEK_API_KEY=sk-你的密钥
QADATA_BASE_URL=https://api.deepseek.com
QADATA_MODEL=deepseek-chat
# 结果表显示行数上限
QADATA_MAX_ROWS=50
# OTel 观测出口（1＝帧流→span 经 OTLP 上报；默认关＝noop，行为逐字节照旧）
QADATA_OTEL_ENABLED=0
# OTLP HTTP 收集端点（Langfuse 自托管例：http://localhost:3000/api/public/otel；空＝回落 OTEL_EXPORTER_OTLP_ENDPOINT）
# QADATA_OTEL_ENDPOINT=
# Langfuse 摄取需鉴权头（OTel 标准 env：base64(public_key:secret_key)）
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(pk:sk)>,x-langfuse-ingestion-version=4
# 例题库召回的向量化模型（空＝召回未配置；端点与正文模型共用 QADATA_BASE_URL，
# 走 OpenAI 兼容 /v1/embeddings；启用判据＝已 qadata examples-sign 人签首批题对）
# QADATA_EMBED_MODEL=text-embedding-v3
